# ADE Supabase sync — credentials.
#
# The RECURRING sync does NOT use this file. Its credential is a
# least-privilege `ade_sync` role stored in the macOS Keychain
# (service "ade-supabase-sync", account "ade_sync"), created by
# bootstrap_scoped_role.py. No service_role key, no DB superuser password
# is kept on disk for day-to-day runs.
#
# This file is only for the ONE-TIME bootstrap. After bootstrap succeeds,
# delete SUPABASE_ADMIN_DB_URL from it (or delete the file).
#
#   cp ade/supabase-sync/.env.example ade/supabase-sync/.env
#
# ---------------------------------------------------------------------------
# SUPABASE_ADMIN_DB_URL — admin (postgres) connection, used ONCE by
# bootstrap_scoped_role.py to apply migrations and create the ade_sync role.
#
# MUST be the "Session" POOLER URI (Dashboard -> Project Settings ->
# Database -> Connection string -> mode "Session"). The Direct URI
# (db.<ref>.supabase.co:5432) is IPv6-only and unreachable from most hosts;
# the pooler is IPv4 and the username carries the project ref.
SUPABASE_ADMIN_DB_URL=postgresql://postgres.your-ref:[PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# Optional — schema the migrations created (default: trading)
# SUPABASE_DB_SCHEMA=trading
#
# Escape hatch only (CI, debugging): if set, this overrides the Keychain
# credential. Leave UNSET in normal use so the scoped Keychain role is used.
# SUPABASE_DB_URL=
